# ══════════════════════════════════════════════════════════════════
#  I Tech IT Solutions — Root .htaccess
#  Handles: clean URLs, browser caching, security headers, gzip
# ══════════════════════════════════════════════════════════════════

# Note: 'Options -Indexes' is commented out by default because many shared hosts
# (cPanel, Hostinger, GoDaddy) forbid 'Options' overrides in .htaccess, causing HTTP 500.
# Directory indexing is already prevented by index.php in every directory.
# Options -Indexes

# ── Enable rewrite engine ───────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── RewriteBase: Use '/' if hosted in domain root (public_html).
    # If installed in a subfolder (e.g. /demo/), change to: RewriteBase /demo/
    RewriteBase /

    # ── Block direct access to sensitive files and directories ──
    RewriteRule ^config/                  - [F,L]
    RewriteRule ^includes/                - [F,L]
    RewriteRule ^admin/_                  - [F,L]
    RewriteRule ^node_modules/            - [F,L]
    RewriteRule ^uploads/\.               - [F,L]
    RewriteRule ^(debug_users|fix_passwords|run_migration)\.php$ - [F,L]
    RewriteRule \.(sql|log|md|json)$      - [F,NC,L]

    # ── Clean URLs to actual PHP handlers ───────────────────────
    RewriteRule ^solutions/([a-z0-9-]+)/?$   public/solution.php?slug=$1 [L,QSA]
    RewriteRule ^services/([a-z0-9-]+)/?$    public/service.php?slug=$1  [L,QSA]
    RewriteRule ^products/([a-z0-9-]+)/?$    public/product.php?slug=$1  [L,QSA]
    RewriteRule ^about/?$                    public/about.php            [L,QSA]
    RewriteRule ^company/?$                  public/company.php          [L,QSA]
    RewriteRule ^solutions/?$                public/index.php#industry-solutions [NE,R=301,L]
    RewriteRule ^services/?$                 public/index.php#services-overview  [NE,R=301,L]
    RewriteRule ^contact/?$                  public/index.php#contact-section    [NE,R=301,L]

    # ── Pass through existing files or directories ──────────────
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

# ── Security headers ────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── GZIP compression ────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ── Browser caching ─────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Images
    ExpiresByType image/jpeg                "access plus 6 months"
    ExpiresByType image/png                 "access plus 6 months"
    ExpiresByType image/webp                "access plus 6 months"
    ExpiresByType image/gif                 "access plus 6 months"
    ExpiresByType image/svg+xml             "access plus 6 months"
    ExpiresByType image/x-icon              "access plus 1 year"

    # Fonts
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"

    # CSS & JS
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"

    # HTML — no cache (dynamic pages)
    ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ── Cache-Control headers ───────────────────────────────────────
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=15552000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ── Prevent access to hidden files (.env, .git, etc.) ──────────
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Block bad bots ──────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_USER_AGENT} (havij|nikto|sqlmap|nessus) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# ── Secure uploads directory: block PHP execution ───────────────
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php|phtml|php3|php4|php5|pl|py|jsp|asp)$ - [F,NC,L]
</IfModule>
