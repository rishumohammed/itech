# Block ALL script execution inside /uploads
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|pl|py|asp|aspx|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block directory listing
Options -Indexes
